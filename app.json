{
  "expo": {
    "name": "Novel Tier",
    "slug": "novel-tier",
    "scheme": "noveltier",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F1A"
    },
    "assetBundlePatterns": ["**/*"],
    "newArchEnabled": true,
    "android": {
      "package": "com.star1water.noveltier",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F1A"
      },
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.star1water.noveltier",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "sdkVersion": "54.0.0",
    "extra": {
      "eas": {
        "projectId": "98ffeff1-a782-48be-a747-f122336c5f2e"
      }
    }
  }
}
